import heapq
graph = {
    'S': ['A', 'B'],
    'A': ['B', 'C', 'D'],
    'B': ['C'],
    'C': ['G'],
    'D': ['G'],
    'G': []
}
h = {'S': 7, 'A': 6, 'B': 4, 'C': 2, 'D': 3, 'G': 0}
def best_first(graph, h, start, goal):
    pq = [(h[start], start, [start])]   # (heuristic, node, path)
    visited = set()
    while pq:
        _, node, path = heapq.heappop(pq)
        if node == goal:
            return path
        if node in visited:
            continue
        visited.add(node)
        for nxt in graph[node]:
            if nxt not in visited:
                heapq.heappush(pq, (h[nxt], nxt, path + [nxt]))
    return None
print("Path:", best_first(graph, h, 'S', 'G'))

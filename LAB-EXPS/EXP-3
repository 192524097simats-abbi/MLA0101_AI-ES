import heapq
graph = {
    'S': {'A': 1, 'B': 4},
    'A': {'B': 2, 'C': 5, 'D': 12},
    'B': {'C': 2},
    'C': {'G': 3},
    'D': {'G': 3},
    'G': {}
}
def ucs(graph, start, goal):
    pq = [(0, start, [start])]    # (cost so far, node, path)
    visited = set()
    while pq:
        cost, node, path = heapq.heappop(pq)
        if node == goal:
            return path, cost
        if node in visited:
            continue
        visited.add(node)
        for nxt, w in graph[node].items():
            if nxt not in visited:
                heapq.heappush(pq, (cost + w, nxt, path + [nxt]))
    return None, float('inf')
path, cost = ucs(graph, 'S', 'G')
print("Least-cost path:", path)
print("Total cost     :", cost)

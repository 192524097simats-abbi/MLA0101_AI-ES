graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': ['F'],
    'F': []
}
def dfs(graph, start, goal):
    stack = [[start]]          
    visited = set()
    order = []
    while stack:
        path = stack.pop()
        node = path[-1]
        if node in visited:
            continue
        visited.add(node)
        order.append(node)
        if node == goal:
            return path, order
        for nxt in reversed(graph[node]):   
            if nxt not in visited:
                stack.append(path + [nxt])
    return None, order
path, order = dfs(graph, 'A', 'F')
print("Visiting order:", order)
print("Path found    :", path)
